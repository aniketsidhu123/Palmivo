{"index":2,"title":"SOLUTION","elements":[{"name":"Text 11","kind":"textbox","text":"SOLUTION","position":{"left":100.8,"top":74.88,"width":835.2,"height":81.6}},{"name":"Solution text panel","kind":"textbox","text":"SignToAST\nIMPLEMENTED PROTOTYPE 04\nMediaPipe landmarks + temporal gesture rules.\nExact Box/Cylinder presets. Two-hand scale, planar move and real subtraction.\nVisible typed AST. Explicit Commit, Cancel and Undo.\nLocal autosave, JSON reopening and keyboard recovery.\nFUTURE ML ROADMAP\nContinuous CAD dataset, torso features, causal ST-GCN + streaming CTC, then ONNX benchmarks.","position":{"left":57.6,"top":177.6,"width":537.6,"height":451.2}},{"name":"Prototype image placeholder","kind":"shape","position":{"left":619.2,"top":177.6,"width":603.17,"height":451.2}},{"name":"Caption","kind":"shape","position":{"left":619.2,"top":388.8,"width":603.17,"height":28.8}},{"name":"Slide Number Placeholder 0","kind":"textbox","text":"3","position":{"left":1142.4,"top":665.28,"width":79.97,"height":28.8}},{"name":"SignToAST screenshot 3","kind":"image","position":{"left":635,"top":233,"width":572,"height":340}}]}
